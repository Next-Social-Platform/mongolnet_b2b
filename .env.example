# Contact form mail (src/app/contact/actions.ts)
# Copy to .env.local for local dev, or deploy/.env on the server.

# Microsoft 365 mailbox the site sends from (needs Authenticated SMTP enabled).
# Any other SMTP works too (e.g. in-v3.mailjet.com, smtp.gmail.com).
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_NO_REPLY_USER=noreply@nextsocial.mn
MAIL_NO_REPLY_PASSWORD=
# Sender address; empty means MAIL_NO_REPLY_USER
MAIL_NO_REPLY_FROM=noreply@nextsocial.mn

# Where contact form messages go
CONTACT_TO=contact@nextsocial.mn
