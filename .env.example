# Contact form mail (src/app/contact/actions.ts)
# Copy to .env.local for local dev, or deploy/.env on the server.

# Mailjet SMTP (free, 200 mails/day). Mailjet -> Account settings -> API Key Management:
#   SMTP_USER = API Key
#   SMTP_PASS = Secret Key
SMTP_USER=
SMTP_PASS=

# Optional, defaults shown. Any other SMTP works too (e.g. smtp.gmail.com, smtp-relay.brevo.com).
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
# nextsocial.mn has Mailjet SPF + DKIM; the sender must be listed in Mailjet -> Senders & Domains
SMTP_FROM=noreply@nextsocial.mn
CONTACT_TO=contact@nextsocial.mn
